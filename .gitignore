projects/wind-daq/apps/desktop-wails/data/logs/
# services/api-go 运行时录制与日志（同上，运行时产物不入库）
projects/*/services/api-go/data/recordings/
projects/*/services/api-go/data/logs/
projects/*/services/api-go/pkg/apiserver/data/logs/

# Playwright 测试产物（npm run test 自动生成，无需入库）
**/playwright-report/
**/test-results/
**/playwright-results.json
**/playwright-results.xml

# Wails 构建产物（go build / wails3 build 输出，无需入库）
**/apps/desktop-wails/build/bin/

# 前端包锁哈希（npm install 自动生成，无需入库）
**/apps/desktop-wails/frontend/package.json.md5

# Release 归档与本地交付包（NSIS installer 拷贝自 build/bin/，按版本号命名；zip 交付包仅本地保留）
# SVN 项目需另行执行：svn propset svn:ignore bin projects/<project>/releases
projects/*/releases/bin/
projects/*/apps/desktop-wails/release/
projects/*/apps/desktop-wails/release/*.zip
projects/*/*.zip

# 工作区根目录的调试 zip 包（daq-debug-<date>.zip 等，运行时/调试打包产物）
/daq-debug-*.zip

# 备份文件（git 已有版本历史，.bak 是反模式）
*.bak

# 临时脚本与数据（一次性生成 i18n / 调试用的 tmp_ 前缀文件，不入库）
tmp_*.py
tmp_*.txt
tmp_*.json

# 临时脚本目录（一次性迁移/对比/重写脚本，目录名 tmp 已暗示临时性）
scripts/tmp/

# E2E 测试输出（截图、HTML 报告、coverage 清单，本地运行产物不入库）
projects/*/docs/test-result/
projects/*/apps/docs/test-result/

# Vite 构建中间产物（dev server 重启时生成 timestamp 后缀的临时 mjs，不应入库）
*.timestamp-*.mjs

# 七孔 PRB 加载器测试动态生成的截断夹具（writeTruncatedPrb 在 testdata/prb/ 下生成）
