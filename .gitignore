# Dependencies
node_modules/

# Build output
dist/
!projects/five-hole-interpolator/apps/desktop-wails/frontend/dist/
projects/five-hole-interpolator/apps/desktop-wails/frontend/dist/*
!projects/five-hole-interpolator/apps/desktop-wails/frontend/dist/.gitkeep
build/
!projects/wind-daq/apps/desktop-wails/build/
projects/wind-daq/apps/desktop-wails/build/*
!projects/wind-daq/apps/desktop-wails/build/config.yml
!projects/wind-daq/apps/desktop-wails/build/windows/installer/project.nsi
target/
*.exe
*.syso
*.dll
*.so

# Wails 生成的前端运行时绑定（由 `wails generate bindings` 自动产出，不入库）
**/apps/desktop-wails/frontend/wailsjs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Cache
npm-cache/
.npm/
*.log
.worktrees/

# Environment
.env
.env.local

# Tools skills repo (nested git and cache)
tools/wuzy-skills/.git/
tools/wuzy-skills/npm-cache/

# Office temp files
~$*
*.docx~

# E2E audit artifacts
wind-daq-*.json

# wind-daq 运行时录制产物（由 StorageRecorder 的 csv_sink 自动生成，
# OutputDir 运行时通过 MkdirAll 创建，无需入库）
projects/wind-daq/apps/desktop-wails/data/recordings/

# Playwright 测试产物（npm run test 自动生成，无需入库）
**/playwright-report/
**/test-results/
**/playwright-results.json
**/playwright-results.xml

# Wails 构建产物（go build / wails3 build 输出，无需入库）
**/apps/desktop-wails/build/bin/

# 前端包锁哈希（npm install 自动生成，无需入库）
**/apps/desktop-wails/frontend/package.json.md5

# Release 归档产物（NSIS installer 拷贝自 build/bin/，按版本号命名，仅本地保留）
# SVN 项目需另行执行：svn propset svn:ignore bin projects/<project>/releases
projects/*/releases/bin/

# 临时脚本与数据（一次性生成 i18n / 调试用的 tmp_ 前缀文件，不入库）
tmp_*.py
tmp_*.txt
tmp_*.json

# 设备 DLL 本地配置（WTNDAQ16H_64.dll 运行时配置，由厂商 SDK 生成，不应入库）
*.ini

# AI 工具工作目录（.workbuddy/ 等，本地会话缓存）
.workbuddy/

# 想法草稿与待沉淀的笔记（docs/ideas/ 为草稿区，正式文档归 docs/ 或 docs/specs/）
docs/ideas/
projects/*/docs/ideas/

# 未成型的实验性项目（1604Cal 等仅本地探索，正式立项后再入库）
projects/1604Cal/

# 本地分析产物与临时文件
analysis/
temp/

# AI 工具私有目录（IDE/agent 本地配置与会话缓存，不应入库）
.codebuddy/
.trae/
.opencode/

# UI 原型工作区（设计稿导出产物，仅本地参考，不入库）
wind-daq-trae-work-prototype/
