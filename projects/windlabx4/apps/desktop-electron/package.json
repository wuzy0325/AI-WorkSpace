{
  "name": "windlabx4-win7",
  "version": "0.15.5-win7.1",
  "private": true,
  "description": "WindLabX4 Windows 7 compatible desktop application",
  "main": "main.cjs",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist:win7": "npm run build:backend && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.wtn.windlabx4.win7",
    "productName": "WindLabX4-win7",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "backend/windlabx4-backend.exe",
        "to": "backend/windlabx4-backend.exe"
      }
    ],
    "win": {
      "icon": "../desktop-wails/appicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WindLabX4",
      "artifactName": "WindLabX4-${version}-${arch}.${ext}"
    }
  }
}
