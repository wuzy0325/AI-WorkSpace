/* 首页专用样式：hero 内的帮助按钮
   其他探针瓦片、hero 主体样式由全局 app.wxss 提供 */
.hero-help {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  font-size: 24rpx;
  color: #fff;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, .18);
  border: 1rpx solid rgba(255, 255, 255, .35);
  letter-spacing: .5rpx;
  line-height: 1.3;
}
/* 点击反馈：底色加深，配合 transform 提供按下感 */
.hero-help-hover {
  background: rgba(255, 255, 255, .32);
  transform: scale(.96);
}
/* hero 容器需要相对定位以承载右上角按钮 */
.hero { position: relative; }
